@echo off
rem =====================================================================
rem  CONFIGURACION GLOBAL DE SQLcl
rem
rem  Aca va SOLO lo que es comun a todos los proyectos.
rem  Lo especifico de cada base/aplicacion va en el proyecto.cmd de cada
rem  carpeta de proyecto (ver README.md).
rem
rem  >>> HAY DOS LINEAS PARA AJUSTAR EN CADA MAQUINA. ESTAN MARCADAS. <<<
rem =====================================================================

rem --- (1) AJUSTAR: JDK que usara SQLcl -------------------------------
rem  SQLcl 26.x funciona con JDK 17/21/26. Se fija el 21 porque el JDK 26
rem  imprime avisos de "restricted method" de JLine en cada arranque.
rem  Verificar la ruta real:  dir "C:\Program Files\Eclipse Adoptium"
set "SQLCL_JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-21.0.12.8-hotspot"

rem --- Modo portable --------------------------------------------------
rem  1 = conexiones guardadas, historial y ajustes viven en C:\SQLcl\home
rem  0 = se usa el perfil del usuario (%USERPROFILE%\.dbtools)
set "SQLCL_PORTABLE=1"

rem --- (2) AJUSTAR: carpeta donde viven los proyectos ------------------
rem  La usa tools\nuevo-proyecto.cmd cuando no le pasas una ruta.
set "PROYECTOS_BASE=C:\Proyectos"

rem --- Fallbacks opcionales -------------------------------------------
rem  Normalmente NO se definen aca: cada proyecto pone los suyos.
rem  set "SQLCL_DEFAULT_CONN="
rem  set "APEX_WORKSPACE="
rem  set "DP_DIRECTORY=DATA_PUMP_DIR"
